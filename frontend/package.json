{
  "name": "inventory-manager-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint --deny-warnings src"
  },
  "dependencies": {
    "@solidjs/router": "^1.0.1",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.91.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  }
}
