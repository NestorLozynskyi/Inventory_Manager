# Docker Compose project name (prefix of containers, volumes, networks).
COMPOSE_PROJECT_NAME=inventory-manager

# --- PostgreSQL ---
POSTGRES_USER=inventory
# REQUIRED: set a strong password (e.g. `openssl rand -hex 24`).
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inventory

# --- Backend ---
# "development" enables /api/docs and /api/openapi.json; keep "production" on the VPS.
APP_ENV=production
LOG_LEVEL=INFO

# --- Caddy / public access ---
# Local: ":80" (plain HTTP). VPS: your domain, e.g. "inventory.example.com" -> automatic HTTPS.
SITE_ADDRESS=:80
# Host interface for published ports. Local: 127.0.0.1. VPS (Caddy as the edge): 0.0.0.0.
PUBLIC_BIND_ADDRESS=127.0.0.1
# Host ports mapped to Caddy's 80/443. Automatic HTTPS on the VPS needs 80 and 443.
HTTP_PORT=8094
HTTPS_PORT=8454

# --- Tests (docker compose --profile test) ---
# Host port of the throwaway test database (bound to 127.0.0.1).
TEST_POSTGRES_PORT=5445

# --- Development override (docker-compose.dev.yml) ---
# Loopback ports for backend (Vite dev proxy target) and PostgreSQL.
BACKEND_HOST_PORT=8010
POSTGRES_HOST_PORT=5444

# --- Accounts & demo ---
# true when the site is served over HTTPS (VPS with a domain) — session cookie gets the Secure flag.
COOKIE_SECURE=false
# Demo workspaces: lifetime and abuse protection (new demos per client IP / overall per hour).
DEMO_LIFETIME_HOURS=24
DEMO_RATE_LIMIT_PER_HOUR=10
DEMO_GLOBAL_LIMIT_PER_HOUR=500
